{
  "name": "vince_portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run blog:validate && npm run projects:validate",
    "prebuild": "npm run blog:validate && npm run projects:validate",
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start",
    "blog:validate": "node scripts/validate-blog.mjs",
    "blog:test:seo": "node scripts/test-blog-seo.mjs",
    "locale:test": "node scripts/test-blog-seo.mjs",
    "projects:validate": "node --conditions=react-server --experimental-strip-types scripts/validate-projects.mjs",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:verify": "node scripts/verify-portfolio-build.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "blog:test:json": "node --test scripts/blog-json-tests/*.node.mjs",
    "blog:test:publication": "node scripts/test-blog-json-publication.mjs",
    "blog:test:preview": "BLOG_PREVIEW=1 playwright test --config scripts/blog-publication-tests/playwright.config.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@types/mdx": "^2.0.14",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "braces": "file:vendor/braces-3.0.4.tgz",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "postcss": "^8",
    "prettier": "3.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4"
  },
  "overrides": {
    "braces": "$braces",
    "postcss-selector-parser": "7.1.7"
  }
}
